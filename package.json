{
  "name": "rabzelj.com",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "NITRO_PRESET=node-server vite build && tsc --noEmit",
    "build:vercel": "NITRO_PRESET=vercel vite build && shx cp -r ./data ./.vercel/output/functions/__server.func/data",
    "clean": "shx rm -rf ./dist ./.output ./.tanstack ./.nitro ./.vercel/output",
    "dev": "vite dev --port 3000",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix-dangerously",
    "script": "node --import tsx/esm --env-file=./.env ./scripts/main.ts",
    "start": "node --env-file=./.env .output/server/index.mjs",
    "typecheck": "tsc --noEmit"
  },
