{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rabzelj-com",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "vars": {
    "TIN_APP_URL": "https://rabzelj.com"
  },
  "routes": [
    {
      "pattern": "rabzelj.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
